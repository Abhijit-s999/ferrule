{
  "name": "ferrule",
  "version": "0.3.0",
  "description": "Free adaptive SAT practice with per-skill analytics and a local AI tutor",
  "license": "MIT",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux AppImage deb",
    "build:win": "electron-builder --win nsis",
    "build:mac": "electron-builder --mac dmg",
    "backend": "./scripts/build-backend.sh",
    "dist": "./scripts/build-backend.sh && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.ferrule.desktop",
    "productName": "ferrule",
    "files": [
      "desktop/**/*",
      "ferrule/**/*",
      "ferrule.py",
      "README.md",
      "ATTRIBUTION.md",
      "LICENSE",
      "!**/__pycache__/**",
      "!**/*.pyc",
      "!ferrule/static/**/*.map"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "desktop/icon.png",
      "maintainer": "ferrule contributors",
      "desktop": {
        "StartupWMClass": "ferrule"
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "desktop/icon.png"
    },
    "directories": {
      "output": "release",
      "buildResources": "desktop"
    },
    "extraResources": [
      {
        "from": "dist/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ferrule"
    }
  },
  "author": {
    "name": "ferrule contributors"
  },
  "homepage": "https://github.com/Abhijit-s999/ferrule",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abhijit-s999/ferrule.git"
  }
}